  "jurytrace": {
    "name": "jurytrace",
    "headline": "Two judges score each trace; disagreements go to humans",
    "punchline": "A judge's quoted evidence must byte-match source[start:end] in the trace, or the verdict becomes a hard failure.",
    "nodes": [
      {
        "id": "traces",
        "label": "Trace JSONL",
        "kind": "input",
        "sub": "trace_id, output, label"
      },
      {
        "id": "hash",
