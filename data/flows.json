        "kind": "input",
        "sub": "messages plus tools"
      },
      {
        "id": "router",
        "label": "Router lookup",
        "kind": "process",
        "sub": "by name or default"
      },
      {
        "id": "schema",
        "label": "One tool schema",
        "kind": "process",
        "sub": "wrapped per provider"
      },
      {
        "id": "http",
        "label": "Provider request",
        "kind": "process",
        "sub": "named HttpClient"
      },
      {
        "id": "parse",
        "label": "Parse inside try",
        "kind": "guard",
        "sub": "raw body preserved"
      },
      {
        "id": "result",
        "label": "ChatResponse or throw",
        "kind": "output",
        "sub": "always PolyAIException"
      }
    ],
    "edges": [
      {
        "from": "call",
        "to": "router"
      },
      {
        "from": "router",
        "to": "schema",
        "label": "provider wire format"
      },
      {
        "from": "schema",
        "to": "http"
      },
      {
        "from": "http",
        "to": "parse",
        "label": "response body"
      },
      {
        "from": "parse",
        "to": "result"
      }
    ]
  },
