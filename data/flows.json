      },
      {
        "id": "drafts",
        "label": "Draft tasks",
        "kind": "store",
        "sub": "IndexedDB, verbatim quote"
      },
      {
        "id": "approve",
        "label": "Human approval",
        "kind": "process",
        "sub": "nothing inferred"
      },
      {
        "id": "packet",
        "label": "Escaped packet",
        "kind": "output",
        "sub": "JSON or Markdown"
      },
      {
        "id": "digest",
        "label": "SHA-256 recheck",
        "kind": "guard",
        "sub": "tampered excerpt rejected"
      }
    ],
    "edges": [
      {
        "from": "notes",
        "to": "prefix"
      },
      {
        "from": "prefix",
        "to": "drafts",
        "label": "title plus citation"
      },
      {
        "from": "drafts",
        "to": "approve",
        "label": "draft until approved"
      },
      {
        "from": "approve",
        "to": "packet",
        "label": "selected only"
      },
      {
        "from": "packet",
        "to": "digest",
        "label": "successor imports"
      },
      {
        "from": "digest",
        "to": "drafts",
        "label": "reset to draft"
      }
    ]
  },
