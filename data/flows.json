      {
        "from": "spans",
        "to": "report"
      }
    ]
  },
  "a11y-scope": {
    "name": "a11y-scope",
    "headline": "Scheduled WCAG scans of your sites, one container",
    "punchline": "No queue: the scans table is the state machine, with failure reasons persisted to the row.",
    "nodes": [
      {
        "id": "trigger",
        "label": "Scan trigger",
        "kind": "input",
        "sub": "cron, button, webhook"
      },
      {
        "id": "pending",
        "label": "Pending scan row",
        "kind": "store",
        "sub": "scans table, 202"
      },
      {
        "id": "scan",
        "label": "Playwright + axe",
        "kind": "process",
        "sub": "headless Chromium, WCAG tags"
      },
      {
        "id": "nodes",
        "label": "Row per node",
        "kind": "store",
        "sub": "selector, HTML, summary"
      },
      {
        "id": "terminal",
        "label": "Done-or-failed row",
        "kind": "guard",
        "sub": "errorMessage persisted in finally"
      },
      {
        "id": "out",
        "label": "Trend and alert",
        "kind": "output",
        "sub": "last 30 scans"
      }
    ],
    "edges": [
      {
        "from": "trigger",
        "to": "pending",
        "label": "insert, return 202"
      },
      {
        "from": "pending",
        "to": "scan",
        "label": "setImmediate"
      },
      {
        "from": "scan",
        "to": "nodes",
        "label": "one row each"
      },
      {
        "from": "nodes",
        "to": "terminal",
        "label": "violationCount written"
      },
      {
        "from": "terminal",
        "to": "out",
        "label": "threshold met"
      }
    ]
  },
  "kindrelay": {
    "name": "kindrelay",
    "headline": "Turns volunteer handover notes into cited, approved tasks",
    "punchline": "No LLM anywhere: a 30-line prefix matcher makes every task traceable to its source line.",
    "nodes": [
      {
        "id": "notes",
