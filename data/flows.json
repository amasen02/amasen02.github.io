        "kind": "guard",
        "sub": "source[start:end] must match"
      },
      {
        "id": "receipts",
        "label": "Agreed receipts",
        "kind": "output",
        "sub": "JSON, JSONL, HTML"
      },
      {
        "id": "queue",
        "label": "Review queue",
        "kind": "store",
        "sub": "SQLite, run-bound rows"
      }
    ],
    "edges": [
      {
        "from": "traces",
        "to": "hash"
      },
      {
        "from": "hash",
        "to": "judges"
      },
      {
        "from": "judges",
        "to": "evidence"
      },
      {
        "from": "evidence",
        "to": "receipts",
        "label": "verdicts agree"
      },
      {
        "from": "evidence",
        "to": "queue",
        "label": "disagree or fabricated"
      }
    ]
  },
