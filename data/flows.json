{
  "freshcart-backend": {
    "name": "freshcart-backend",
    "headline": "Twelve .NET services move one order, exactly once",
    "nodes": [
      {
        "id": "cookie",
        "label": "Browser cookie",
        "sub": "HttpOnly, SameSite=Strict",
        "kind": "input"
      },
      {
        "id": "bff",
        "label": "Gateway mints JWT",
        "sub": "cached per auth_time",
        "kind": "process"
      },
      {
        "id": "unique",
        "label": "Partial unique index",
        "sub": "OrderId, Version==1",
        "kind": "guard"
      },
      {
        "id": "events",
        "label": "Mongo event batch",
        "sub": "plus projection marker",
        "kind": "store"
      },
      {
        "id": "outbox",
        "label": "Outbox claim drain",
        "sub": "leased ClaimId per row",
        "kind": "process"
      },
      {
        "id": "read",
        "label": "SQL read model",
        "sub": "inbox row in-transaction",
        "kind": "output"
      }
    ],
    "edges": [
      {
        "from": "cookie",
        "to": "bff",
        "label": "no token client-side"
      },
      {
        "from": "bff",
        "to": "unique",
        "label": "initiate payment"
      },
      {
        "from": "unique",
        "to": "events",
        "label": "first write wins"
      },
      {
        "from": "events",
        "to": "outbox",
        "label": "staged event"
      },
      {
        "from": "outbox",
        "to": "read",
        "label": "at-least-once delivery"
      }
    ],
    "punchline": "A second concurrent initiate for the same order fails on a unique index in the event store."
  },
  "freshcart-web": {
    "name": "freshcart-web",
    "headline": "Angular storefront that never holds a token in JavaScript",
    "nodes": [
      {
        "id": "cookie",
        "label": "Session cookie",
        "sub": "HttpOnly, gateway-issued",
        "kind": "input"
      },
      {
        "id": "xsrf",
        "label": "XSRF interceptor",
        "sub": "echoes XSRF-TOKEN header",
        "kind": "process"
      },
      {
        "id": "store",
        "label": "Signal store",
        "sub": "ngrx signals, zoneless",
        "kind": "store"
      },
      {
        "id": "lifecycle",
        "label": "Serialised hub lifecycle",
        "sub": "promise chain, handlers off()",
        "kind": "guard"
      },
      {
        "id": "hub",
        "label": "SignalR hub",
        "sub": "withCredentials, no accessTokenFactory",
        "kind": "process"
      },
      {
        "id": "view",
        "label": "Order status view",
        "sub": "realtime first, bounded poll",
        "kind": "output"
      }
    ],
    "edges": [
      {
        "from": "cookie",
        "to": "xsrf",
        "label": "same-origin /api"
      },
      {
        "from": "xsrf",
        "to": "store",
        "label": "typed ApiError"
      },
      {
        "from": "store",
        "to": "lifecycle",
        "label": "auth state flips"
      },
      {
        "from": "lifecycle",
        "to": "hub",
        "label": "start or stop"
      },
      {
        "from": "hub",
        "to": "view",
        "label": "live status push"
      }
    ],
    "punchline": "SignalR connects on the session cookie with no accessTokenFactory, so no bearer token reaches logs or JavaScript."
  },
  "diagif": {
    "name": "diagif",
    "headline": "A topic becomes a fact-checked, machine-verified looping GIF",
    "nodes": [
      {
        "id": "topic",
        "label": "Topic string",
        "sub": "diagif make <topic>",
        "kind": "input"
      },
      {
        "id": "fetch",
        "label": "Pinned page fetch",
        "sub": "SSRF-hardened, 2MB cap",
        "kind": "process"
      },
      {
        "id": "facts",
        "label": "Fact sheet claims",
        "sub": "quotes found verbatim",
        "kind": "process"
      },
      {
        "id": "scene",
        "label": "Chromium bbox measure",
        "sub": "deterministic repair, no model",
        "kind": "process"
      },
      {
        "id": "gate",
        "label": "GIF decode gate",
        "sub": "seam hash, delay grid",
        "kind": "guard"
      },
      {
        "id": "out",
        "label": "Looping GIF",
        "sub": "plus 3x3 contact sheet",
        "kind": "output"
      }
    ],
    "edges": [
      {
        "from": "topic",
        "to": "fetch",
        "label": "HN, GitHub, pages"
      },
      {
        "from": "fetch",
        "to": "facts",
        "label": "hashed extract"
      },
      {
        "from": "facts",
        "to": "scene",
        "label": "schema-valid scene"
      },
      {
        "from": "scene",
        "to": "gate",
        "label": "capture and encode"
      },
      {
        "from": "gate",
        "to": "out",
        "label": "promote"
      }
    ],
    "punchline": "The gate decodes the delivered GIF and checks frame delays, loop-seam hashes and reserved-colour pixel counts."
  },
  "fastdl": {
    "name": "fastdl",
    "headline": "Downloads one file over many parallel connections",
    "nodes": [
      {
        "id": "url",
        "label": "File URL",
        "kind": "input",
        "sub": "one or more mirrors"
      },
      {
        "id": "probe",
        "label": "Range probe",
        "kind": "process",
        "sub": "expects exact Content-Range"
      },
      {
        "id": "queue",
        "label": "Chunk queue",
        "kind": "process",
        "sub": "workers dequeue chunks"
      },
      {
        "id": "write",
        "label": "Write at offset",
        "kind": "process",
        "sub": "RandomAccess, no lock"
      },
      {
        "id": "bitmap",
        "label": "Chunk bitmap",
        "kind": "store",
        "sub": ".fdlmeta sidecar file"
      },
      {
        "id": "verify",
        "label": "Byte-identical SHA-256",
        "kind": "guard",
        "sub": "asserted in tests"
      }
    ],
    "edges": [
      {
        "from": "url",
        "to": "probe",
        "label": "Range 0-0"
      },
      {
        "from": "probe",
        "to": "queue",
        "label": "206 accepted"
      },
      {
        "from": "queue",
        "to": "write",
        "label": "N parallel workers"
      },
      {
        "from": "write",
        "to": "bitmap",
        "label": "chunk complete"
      },
      {
        "from": "bitmap",
        "to": "queue",
        "label": "resume skips done"
      },
      {
        "from": "write",
        "to": "verify",
        "label": "assembled output"
      }
    ],
    "punchline": "Segmentation is accepted only when the probe returns 206 with Content-Range exactly 0-0."
  },
  "dupesweep": {
    "name": "dupesweep",
    "headline": "Finds byte-identical duplicates and quarantines them reversibly",
    "nodes": [
      {
        "id": "roots",
        "label": "Directory roots",
        "kind": "input",
        "sub": "one or more"
      },
      {
        "id": "size",
        "label": "Group by size",
        "kind": "process",
        "sub": "no bytes read"
      },
      {
        "id": "head",
        "label": "First 64KB hash",
        "kind": "process",
        "sub": "SHA-256, parallel"
      },
      {
        "id": "full",
        "label": "Full SHA-256",
        "kind": "process",
        "sub": "survivors only"
      },
      {
        "id": "quarantine",
        "label": "Quarantine move",
        "kind": "store",
        "sub": "writes manifest.json"
      },
      {
        "id": "restore",
        "label": "Restore never overwrites",
        "kind": "guard",
        "sub": "skips occupied path"
      }
    ],
    "edges": [
      {
        "from": "roots",
        "to": "size",
        "label": "file lengths"
      },
      {
        "from": "size",
        "to": "head",
        "label": "same-size groups"
      },
      {
        "from": "head",
        "to": "full",
        "label": "prefix matches"
      },
      {
        "from": "full",
        "to": "quarantine",
        "label": "keep policy picks"
      },
      {
        "from": "quarantine",
        "to": "restore",
        "label": "dsweep restore"
      }
    ],
    "punchline": "Parallel hashing writes into a pre-allocated array by index, so scan order and --keep first stay deterministic."
  },
  "dupehunter": {
    "name": "dupehunter",
    "headline": "Finds duplicate files, counting hardlinks as one",
    "nodes": [
      {
        "id": "walk",
        "label": "Directory walk",
        "kind": "input",
        "sub": "size and glob filters"
      },
      {
        "id": "collapse",
        "label": "Collapse by inode",
        "kind": "process",
        "sub": "paths become PhysicalFile"
      },
      {
        "id": "hash",
        "label": "Streaming SHA-256",
        "kind": "process",
        "sub": "size collisions only"
      },
      {
        "id": "report",
        "label": "Group report",
        "kind": "output",
        "sub": "text or JSON"
      },
      {
        "id": "link",
        "label": "Link then rename",
        "kind": "guard",
        "sub": "atomic, temp file"
      }
    ],
    "edges": [
      {
        "from": "walk",
        "to": "collapse",
        "label": "device:inode key"
      },
      {
        "from": "collapse",
        "to": "hash",
        "label": "same-size buckets"
      },
      {
        "from": "hash",
        "to": "report",
        "label": "identical groups"
      },
      {
        "from": "report",
        "to": "link",
        "label": "hardlink confirmed"
      }
    ],
    "punchline": "Reclaimable space is size times physical files minus one, so a hardlink pass is idempotent."
  },
  "postwright": {
    "name": "postwright",
    "headline": "Drafts social posts, publishes only after verified readback",
    "punchline": "Release has three outcomes \u2014 released, refused, uncertain \u2014 because a retry after an ambiguous publish duplicate-posts.",
    "nodes": [
      {
        "id": "topic",
        "label": "Topic line",
        "kind": "input",
        "sub": "one subject"
      },
      {
        "id": "drafts",
        "label": "Staged drafts",
        "kind": "store",
        "sub": "X, LinkedIn, dev.to"
      },
      {
        "id": "lint",
        "label": "Twelve lint rules",
        "kind": "process",
        "sub": "R1-R12 per channel"
      },
      {
        "id": "publish",
        "label": "Publish one channel",
        "kind": "process",
        "sub": "--confirm required"
      },
      {
        "id": "readback",
        "label": "Readback match",
        "kind": "guard",
        "sub": "refetch the live post"
      },
      {
        "id": "receipt",
        "label": "Receipt or uncertain",
        "kind": "output",
        "sub": "inflight blocks retry"
      }
    ],
    "edges": [
      {
        "from": "topic",
        "to": "drafts",
        "label": "stage on disk"
      },
      {
        "from": "drafts",
        "to": "lint"
      },
      {
        "from": "lint",
        "to": "publish",
        "label": "hash must match"
      },
      {
        "from": "publish",
        "to": "readback"
      },
      {
        "from": "readback",
        "to": "receipt"
      }
    ]
  },
  "polyai-dotnet": {
    "name": "polyai-dotnet",
